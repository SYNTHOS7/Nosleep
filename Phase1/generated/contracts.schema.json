{
  "$defs": {
    "AnswerLanguage": {
      "enum": [
        "auto",
        "en",
        "hi"
      ],
      "title": "AnswerLanguage",
      "type": "string"
    },
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_hash": {
          "title": "Text Hash",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/ChunkLocation"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "document_id",
        "revision_id",
        "index",
        "text",
        "text_hash",
        "location"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "ChunkLocation": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "minimum": 0,
          "title": "End Offset",
          "type": "integer"
        }
      },
      "required": [
        "start_offset",
        "end_offset"
      ],
      "title": "ChunkLocation",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "left_relation_id": {
          "title": "Left Relation Id",
          "type": "string"
        },
        "right_relation_id": {
          "title": "Right Relation Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConflictKind"
        },
        "state": {
          "$ref": "#/$defs/ConflictState"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Chunk Ids",
          "type": "array"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "left_relation_id",
        "right_relation_id",
        "kind",
        "state",
        "explanation",
        "detector_version"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "ConflictKind": {
      "enum": [
        "negation",
        "exclusive_value",
        "incompatible_statement"
      ],
      "title": "ConflictKind",
      "type": "string"
    },
    "ConflictState": {
      "enum": [
        "potential",
        "supported"
      ],
      "title": "ConflictState",
      "type": "string"
    },
    "CorpusSnapshot": {
      "additionalProperties": false,
      "description": "Task 1's consistent read boundary from authoritative Neo4j publication state.",
      "properties": {
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "active_revision_ids": {
          "items": {
            "type": "string"
          },
          "title": "Active Revision Ids",
          "type": "array"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "epoch",
        "captured_at"
      ],
      "title": "CorpusSnapshot",
      "type": "object"
    },
    "DerivedDelta": {
      "additionalProperties": false,
      "description": "Task 3's staged topic/conflict changes; Task 1 alone validates and publishes them.",
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/CorpusSnapshot"
        },
        "staged_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staged Revision Id"
        },
        "topics_to_upsert": {
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "title": "Topics To Upsert",
          "type": "array"
        },
        "topic_memberships_to_upsert": {
          "items": {
            "$ref": "#/$defs/TopicMembership"
          },
          "title": "Topic Memberships To Upsert",
          "type": "array"
        },
        "conflicts_to_upsert": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "title": "Conflicts To Upsert",
          "type": "array"
        },
        "conflict_ids_to_retire": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Ids To Retire",
          "type": "array"
        }
      },
      "required": [
        "operation_id",
        "snapshot"
      ],
      "title": "DerivedDelta",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "active_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Revision Id"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "filename",
        "source_type",
        "created_at"
      ],
      "title": "Document",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "normalized_name": {
          "title": "Normalized Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "name",
        "normalized_name",
        "type"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityMention": {
      "additionalProperties": false,
      "description": "A source-bound occurrence of a canonical Entity.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "document_id",
        "revision_id",
        "entity_id",
        "chunk_id",
        "start",
        "end",
        "quote",
        "created_at"
      ],
      "title": "EntityMention",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "start",
        "end",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidencePackage": {
      "additionalProperties": false,
      "description": "A reference-closed, potentially partial evidence set from one CorpusSnapshot.",
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/CorpusSnapshot"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/Document"
          },
          "title": "Documents",
          "type": "array"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/Revision"
          },
          "title": "Revisions",
          "type": "array"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/Chunk"
          },
          "title": "Chunks",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        },
        "entity_mentions": {
          "items": {
            "$ref": "#/$defs/EntityMention"
          },
          "title": "Entity Mentions",
          "type": "array"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "title": "Values",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "title": "Topics",
          "type": "array"
        },
        "topic_memberships": {
          "items": {
            "$ref": "#/$defs/TopicMembership"
          },
          "title": "Topic Memberships",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/EvidencePath"
          },
          "title": "Paths",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "available_chunk_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Chunk Count"
        },
        "searched_chunk_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Searched Chunk Count"
        }
      },
      "required": [
        "snapshot"
      ],
      "title": "EvidencePackage",
      "type": "object"
    },
    "EvidencePath": {
      "additionalProperties": false,
      "description": "A connected, directed factual path; topic memberships never appear as steps.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "snapshot_epoch": {
          "minimum": 0,
          "title": "Snapshot Epoch",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/EvidencePathStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "snapshot_epoch",
        "steps"
      ],
      "title": "EvidencePath",
      "type": "object"
    },
    "EvidencePathStep": {
      "additionalProperties": false,
      "description": "One directed traversal of a source-specific relation with its source provenance.",
      "properties": {
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "object_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Entity Id"
        },
        "object_value_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Value Id"
        },
        "traversal_direction": {
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Traversal Direction",
          "type": "string"
        },
        "evidence_chunk_id": {
          "title": "Evidence Chunk Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "subject_id",
        "traversal_direction",
        "evidence_chunk_id",
        "revision_id",
        "document_id"
      ],
      "title": "EvidencePathStep",
      "type": "object"
    },
    "ExtractionBatch": {
      "additionalProperties": false,
      "description": "Task 2's source-supported staging payload, validated locally before repository checks.",
      "properties": {
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "embedding_version": {
          "title": "Embedding Version",
          "type": "string"
        },
        "embedding_dimension": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimension",
          "type": "integer"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/Chunk"
          },
          "minItems": 1,
          "title": "Chunks",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        },
        "entity_mentions": {
          "items": {
            "$ref": "#/$defs/EntityMention"
          },
          "title": "Entity Mentions",
          "type": "array"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "title": "Values",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "chunk_vectors": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Chunk Vectors",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "workspace_id",
        "document_id",
        "revision_id",
        "embedding_version",
        "embedding_dimension",
        "chunks",
        "chunk_vectors"
      ],
      "title": "ExtractionBatch",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "expected_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision Id"
        },
        "new_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Revision Id"
        },
        "state": {
          "$ref": "#/$defs/OperationState",
          "default": "queued"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        },
        "visible_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "checkpoint": {
          "additionalProperties": true,
          "title": "Checkpoint",
          "type": "object"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings Ms",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "document_id",
        "kind",
        "stage",
        "accepted_at",
        "deadline_at"
      ],
      "title": "Operation",
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "add",
        "edit",
        "delete"
      ],
      "title": "OperationKind",
      "type": "string"
    },
    "OperationState": {
      "enum": [
        "queued",
        "running",
        "ready",
        "failed"
      ],
      "title": "OperationState",
      "type": "string"
    },
    "PublishReceipt": {
      "additionalProperties": false,
      "description": "Neo4j authoritative publication result; cleanup and read probe remain operation work.",
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "publication_kind": {
          "enum": [
            "initial",
            "replacement",
            "deletion",
            "noop"
          ],
          "title": "Publication Kind",
          "type": "string"
        },
        "previous_epoch": {
          "minimum": 0,
          "title": "Previous Epoch",
          "type": "integer"
        },
        "resulting_epoch": {
          "minimum": 0,
          "title": "Resulting Epoch",
          "type": "integer"
        },
        "previous_active_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Active Revision Id"
        },
        "active_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Revision Id"
        },
        "neo4j_publication_applied": {
          "title": "Neo4J Publication Applied",
          "type": "boolean"
        },
        "vectors_verified_before_publication": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vectors Verified Before Publication"
        },
        "post_publication_cleanup_required": {
          "title": "Post Publication Cleanup Required",
          "type": "boolean"
        },
        "read_probe_required": {
          "title": "Read Probe Required",
          "type": "boolean"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "workspace_id",
        "document_id",
        "publication_kind",
        "previous_epoch",
        "resulting_epoch",
        "neo4j_publication_applied",
        "post_publication_cleanup_required",
        "read_probe_required",
        "published_at"
      ],
      "title": "PublishReceipt",
      "type": "object"
    },
    "QueryRequest": {
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "topic_ids": {
          "items": {
            "type": "string"
          },
          "title": "Topic Ids",
          "type": "array"
        },
