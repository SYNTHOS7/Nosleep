# ==============================================================================
# Interactive Knowledge Base — Storage & Service Configuration
# ==============================================================================

# Storage Backend Mode:
# Set to 'in_memory' for fast, offline, isolated local execution (default in tests)
# Neo4j connection support exists; ingestion write-through remains unfinished.
STORAGE_BACKEND=in_memory

# ------------------------------------------------------------------------------
# Neo4j AuraDB / Self-Hosted Neo4j Configuration
# ------------------------------------------------------------------------------
# URI examples:
#   AuraDB:      neo4j+s://<instance-id>.databases.neo4j.io
#   Local Neo4j: bolt://localhost:7687 or neo4j://localhost:7687
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# Chroma Vector Database Configuration
# ------------------------------------------------------------------------------
# Path where ChromaDB stores persistent vector embeddings on disk
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_MIRROR_ENABLED=false

# ------------------------------------------------------------------------------
# Server Network Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080

# Hosted setup: Vercel frontend -> Render API -> Neon + optional Neo4j.
# Local tests use in_memory; production selects neon.
VECTOR_BACKEND=in_memory
# demo is allowed only in local, non-Neon mode. Hosted deployments use neon.
AUTH_MODE=demo
# Backend-only pooled PostgreSQL URL; never put this in a VITE_ variable.
DATABASE_URL=
NEON_AUTH_URL=
SERVE_FRONTEND=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
