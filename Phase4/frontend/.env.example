# Leave blank to use the Vercel rewrites in vercel.json.
# For direct browser requests to Render, set its URL and configure CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Public Neon Auth endpoint from the same Neon branch as the backend.
# Never put DATABASE_URL or a Neon management API key here.
VITE_NEON_AUTH_URL=
