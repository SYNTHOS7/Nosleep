{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://nosleep-n1ae.onrender.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://nosleep-n1ae.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
